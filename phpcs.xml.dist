<?xml version="1.0"?>
<ruleset name="HostelMate for HBook">
	<description>WordPress-Extra plus the WordPress security sniffs. Zero warnings to merge.</description>
	<config name="installed_paths" value="tools/vendor/wpcs,tools/vendor/phpcsutils,tools/vendor/phpcsextra"/>
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.2-"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<file>hostelmate-hbook.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<exclude-pattern>*/tools/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<rule ref="WordPress-Extra">
		<!-- Files are named after their class (PSR-4 style autoloader). -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="hostelmate-hbook"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="hostelmate_hbook"/><element value="HostelMate\HBook"/></property></properties>
	</rule>
</ruleset>
